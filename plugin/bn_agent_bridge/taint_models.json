{
  "_schema_version": 1,
  "_doc": "Taint semantics for external/library functions consumed by the bn taint engine. Keys are symbol names (leading underscores / common decorations are stripped when matching). Grammar for from/to: 'arg:N' = value of the Nth (0-based) argument, '*arg:N' = the buffer the Nth argument points to (its pointee variable), 'ret' = return value, '*ret' = pointee of returned pointer. 'sources' seed taint; 'propagates' move taint from->to when 'from' is tainted; 'sink.tainted_args' lists argument indices whose taint is reportable, with a 'class' bug-class hint. Keys beginning with '_' are ignored. A user override at the path from paths.taint_models_path() is merged over these.",
  "models": {
    "_comment_return_bound": "return_bound.max_from_arg N: the return value (bytes received) is provably <= the constant in arg N (the count). Lets forward taint downgrade `m = read(fd,buf,MAX); memcpy(dst,buf,m)` from overflow to bounded_len with source_bound=MAX (#159).",
    "read":         {"sources": [{"to": "*arg:1"}, {"to": "ret"}], "return_bound": {"max_from_arg": 2}},
    "recv":         {"sources": [{"to": "*arg:1"}, {"to": "ret"}], "return_bound": {"max_from_arg": 2}},
    "recvfrom":     {"sources": [{"to": "*arg:1"}, {"to": "ret"}], "return_bound": {"max_from_arg": 2}},
    "fread":        {"sources": [{"to": "*arg:0"}, {"to": "ret"}]},
    "fgets":        {"sources": [{"to": "*arg:0"}, {"to": "ret"}]},
    "gets":         {"sources": [{"to": "*arg:0"}, {"to": "ret"}],
                     "sink": {"tainted_args": [], "class": "unbounded_input", "detail": "gets() is always unsafe (no bound)"}},
    "getenv":       {"sources": [{"to": "ret"}]},
    "scanf":        {"sources": [{"to": "*arg:1"}]},
    "__isoc99_scanf": {"sources": [{"to": "*arg:1"}]},
    "sscanf":       {"propagates": [{"from": "*arg:0", "to": "*arg:2"}]},

    "atoi":         {"propagates": [{"from": "*arg:0", "to": "ret"}]},
    "atol":         {"propagates": [{"from": "*arg:0", "to": "ret"}]},
    "atoll":        {"propagates": [{"from": "*arg:0", "to": "ret"}]},
    "strtol":       {"propagates": [{"from": "*arg:0", "to": "ret"}]},
    "strtoul":      {"propagates": [{"from": "*arg:0", "to": "ret"}]},
    "strlen":       {"propagates": [{"from": "*arg:0", "to": "ret"}]},
    "strdup":       {"propagates": [{"from": "*arg:0", "to": "*ret"}]},

    "memcpy":       {"propagates": [{"from": "*arg:1", "to": "*arg:0"}],
                     "sink": {"tainted_args": [2], "class": "overflow_len", "detail": "attacker-controlled length to memcpy"}},
    "memmove":      {"propagates": [{"from": "*arg:1", "to": "*arg:0"}],
                     "sink": {"tainted_args": [2], "class": "overflow_len", "detail": "attacker-controlled length to memmove"}},
    "memset":       {"sink": {"tainted_args": [2], "class": "overflow_len", "detail": "attacker-controlled length to memset"}},
    "strcpy":       {"propagates": [{"from": "*arg:1", "to": "*arg:0"}],
                     "sink": {"tainted_args": [1], "class": "overflow_unbounded", "detail": "unbounded copy of tainted source into strcpy dest"}},
    "stpcpy":       {"propagates": [{"from": "*arg:1", "to": "*arg:0"}],
                     "sink": {"tainted_args": [1], "class": "overflow_unbounded", "detail": "unbounded copy via stpcpy"}},
    "strncpy":      {"propagates": [{"from": "*arg:1", "to": "*arg:0"}],
                     "sink": {"tainted_args": [2], "class": "overflow_len", "detail": "attacker-controlled length to strncpy"}},
    "strcat":       {"propagates": [{"from": "*arg:1", "to": "*arg:0"}],
                     "sink": {"tainted_args": [1], "class": "overflow_unbounded", "detail": "unbounded append of tainted source into strcat dest"}},
    "strncat":      {"propagates": [{"from": "*arg:1", "to": "*arg:0"}],
                     "sink": {"tainted_args": [2], "class": "overflow_len", "detail": "attacker-controlled length to strncat"}},
    "sprintf":      {"propagates": [{"from": "*arg:1", "to": "*arg:0"}],
                     "varargs": {"first_index": 2, "to": "*arg:0", "sink": true},
                     "sink": {"tainted_args": [1], "class": "format_or_overflow", "detail": "tainted format/args into sprintf"}},
    "snprintf":     {"propagates": [{"from": "*arg:2", "to": "*arg:0"}],
                     "varargs": {"first_index": 3, "to": "*arg:0"},
                     "sink": {"tainted_args": [2], "class": "format_or_overflow", "detail": "tainted size/format into snprintf"}},
    "vsprintf":     {"propagates": [{"from": "*arg:1", "to": "*arg:0"}],
                     "sink": {"tainted_args": [1], "class": "format_or_overflow", "detail": "tainted format into vsprintf"}},
    "_comment_format_v": "Plain (non-_chk) v-printf family + asprintf/dprintf (#317): the unfortified libc formatters that an internal vformatter wrapper bottoms out at -- previously only the _chk/_s variants were modeled, so a tainted format routed through e.g. a `gs_snprintf` wrapper calling plain vsnprintf passed through unflagged. v* take a va_list (no discoverable varargs); the format-string arg is the sink.",
    "vsnprintf":    {"propagates": [{"from": "*arg:2", "to": "*arg:0"}],
                     "sink": {"tainted_args": [2], "class": "format_or_overflow", "detail": "tainted size/format into vsnprintf"}},
    "vprintf":      {"sink": {"tainted_args": [0], "class": "format_string", "detail": "tainted format argument to vprintf"}},
    "vfprintf":     {"sink": {"tainted_args": [1], "class": "format_string", "detail": "tainted format argument to vfprintf"}},
    "vdprintf":     {"sink": {"tainted_args": [1], "class": "format_string", "detail": "tainted format argument to vdprintf"}},
    "dprintf":      {"sink": {"tainted_args": [1], "class": "format_string", "detail": "tainted format argument to dprintf"}},
    "asprintf":     {"sink": {"tainted_args": [1], "class": "format_or_overflow", "detail": "tainted format into asprintf"}},
    "vasprintf":    {"sink": {"tainted_args": [1], "class": "format_or_overflow", "detail": "tainted format into vasprintf"}},
    "_comment_format_chk": "Fortified printf-family: leading flag/strlen (and maxlen for snprintf) args shift the format string + varargs right. v* take a va_list (no discoverable varargs), so no 'varargs'.",
    "sprintf_chk":  {"propagates": [{"from": "*arg:3", "to": "*arg:0"}],
                     "varargs": {"first_index": 4, "to": "*arg:0", "sink": true},
                     "sink": {"tainted_args": [3], "class": "fortified_format", "detail": "tainted format/args into __sprintf_chk"}},
    "snprintf_chk": {"propagates": [{"from": "*arg:4", "to": "*arg:0"}],
                     "varargs": {"first_index": 5, "to": "*arg:0"},
                     "sink": {"tainted_args": [4], "class": "fortified_format", "detail": "tainted format/args into __snprintf_chk"}},
    "vsprintf_chk": {"propagates": [{"from": "*arg:3", "to": "*arg:0"}],
                     "sink": {"tainted_args": [3], "class": "fortified_format", "detail": "tainted format into __vsprintf_chk"}},
    "vsnprintf_chk":{"propagates": [{"from": "*arg:4", "to": "*arg:0"}],
                     "sink": {"tainted_args": [4], "class": "fortified_format", "detail": "tainted format into __vsnprintf_chk"}},
    "printf_chk":   {"sink": {"tainted_args": [1], "class": "format_string", "detail": "tainted format argument to __printf_chk"}},
    "fprintf_chk":  {"sink": {"tainted_args": [2], "class": "format_string", "detail": "tainted format argument to __fprintf_chk"}},

    "printf":       {"sink": {"tainted_args": [0], "class": "format_string", "detail": "tainted format argument to printf"}},
    "fprintf":      {"sink": {"tainted_args": [1], "class": "format_string", "detail": "tainted format argument to fprintf"}},
    "system":       {"sink": {"tainted_args": [0], "class": "command_injection", "detail": "tainted command to system()"}},
    "popen":        {"sink": {"tainted_args": [0], "class": "command_injection", "detail": "tainted command to popen()"}},
    "execl":        {"sink": {"tainted_args": [0], "class": "command_injection", "detail": "tainted path to execl()"}},
    "execlp":       {"sink": {"tainted_args": [0], "class": "command_injection", "detail": "tainted file to execlp()"}},
    "execv":        {"sink": {"tainted_args": [0], "class": "command_injection", "detail": "tainted path to execv()"}},
    "execve":       {"sink": {"tainted_args": [0], "class": "command_injection", "detail": "tainted path to execve()"}},
    "malloc":       {"sink": {"tainted_args": [0], "class": "alloc_size", "detail": "attacker-controlled allocation size to malloc"}},
    "calloc":       {"sink": {"tainted_args": [0, 1], "class": "alloc_size", "detail": "attacker-controlled allocation size to calloc"}},
    "realloc":      {"sink": {"tainted_args": [1], "class": "alloc_size", "detail": "attacker-controlled allocation size to realloc"}},
    "alloca":       {"sink": {"tainted_args": [0], "class": "alloc_size", "detail": "attacker-controlled alloca size (stack)"}},

    "_comment_cxx_new": "C++ operator new / new[] (Itanium ABI). Keyed underscore-stripped (Znwm/Znam) so the mangled symbols resolve via lookup_model, which also canonicalizes the size_t-overload (Znwm/Znwj), nothrow/aligned suffixes, and the demangled 'operator new'/'operator new[]' spellings to these two keys (#204). Like malloc, the size is arg 0. Placement new (_ZnwmPv / 'operator new(size, void*)') does not allocate and is excluded by lookup_model, so it never reaches here.",
    "Znwm":         {"sink": {"tainted_args": [0], "class": "alloc_size", "detail": "attacker-controlled allocation size to operator new"}},
    "Znam":         {"sink": {"tainted_args": [0], "class": "alloc_size", "detail": "attacker-controlled allocation size to operator new[]"}},

    "_comment_fortified": "FORTIFY_SOURCE (-D_FORTIFY_SOURCE) _chk variants. Keyed underscore-stripped so __memcpy_chk etc. resolve here (lookup_model strips leading underscores). The extra trailing destlen/objsize args are compile-time guards, not data flow. Copy/concat use the 'fortified_overflow' class: the call still aborts at runtime, so it is lower-severity than the raw variant but a tainted length/source reaching it is worth surfacing. Format _chk variants live in the format section (they also carry 'varargs').",
    "read_chk":     {"sources": [{"to": "*arg:1"}, {"to": "ret"}], "return_bound": {"max_from_arg": 2}},
    "recv_chk":     {"sources": [{"to": "*arg:1"}, {"to": "ret"}], "return_bound": {"max_from_arg": 2}},
    "recvfrom_chk": {"sources": [{"to": "*arg:1"}, {"to": "ret"}], "return_bound": {"max_from_arg": 2}},
    "pread_chk":    {"sources": [{"to": "*arg:1"}, {"to": "ret"}], "return_bound": {"max_from_arg": 2}},
    "fgets_chk":    {"sources": [{"to": "*arg:0"}, {"to": "ret"}]},
    "fread_chk":    {"sources": [{"to": "*arg:0"}, {"to": "ret"}]},
    "memcpy_chk":   {"propagates": [{"from": "*arg:1", "to": "*arg:0"}],
                     "sink": {"tainted_args": [2], "class": "fortified_overflow", "detail": "attacker-controlled length to __memcpy_chk (fortified; aborts at runtime)"}},
    "memmove_chk":  {"propagates": [{"from": "*arg:1", "to": "*arg:0"}],
                     "sink": {"tainted_args": [2], "class": "fortified_overflow", "detail": "attacker-controlled length to __memmove_chk (fortified; aborts at runtime)"}},
    "memset_chk":   {"sink": {"tainted_args": [2], "class": "fortified_overflow", "detail": "attacker-controlled length to __memset_chk (fortified; aborts at runtime)"}},
    "strcpy_chk":   {"propagates": [{"from": "*arg:1", "to": "*arg:0"}],
                     "sink": {"tainted_args": [1], "class": "fortified_overflow", "detail": "unbounded copy of tainted source into __strcpy_chk dest (fortified; aborts at runtime)"}},
    "stpcpy_chk":   {"propagates": [{"from": "*arg:1", "to": "*arg:0"}],
                     "sink": {"tainted_args": [1], "class": "fortified_overflow", "detail": "unbounded copy via __stpcpy_chk (fortified; aborts at runtime)"}},
    "strncpy_chk":  {"propagates": [{"from": "*arg:1", "to": "*arg:0"}],
                     "sink": {"tainted_args": [2], "class": "fortified_overflow", "detail": "attacker-controlled length to __strncpy_chk (fortified; aborts at runtime)"}},
    "strcat_chk":   {"propagates": [{"from": "*arg:1", "to": "*arg:0"}],
                     "sink": {"tainted_args": [1], "class": "fortified_overflow", "detail": "unbounded append of tainted source into __strcat_chk dest (fortified; aborts at runtime)"}},
    "strncat_chk":  {"propagates": [{"from": "*arg:1", "to": "*arg:0"}],
                     "sink": {"tainted_args": [2], "class": "fortified_overflow", "detail": "attacker-controlled length to __strncat_chk (fortified; aborts at runtime)"}},

    "_comment_annex_k": "C11 Annex-K / 'secure CRT' *_s variants. A destsz/bufsz guard arg follows the destination, shifting src/count/format one position right vs the classic libc functions: the copy family is (dest, destsz, src[, count]); the printf family is (buffer, bufsz, format, ...). They are bounds-checked and abort at runtime, so they reuse the lower-severity fortified_* classes of the __*_chk family. Positions follow the Annex-K signatures (NOT the Microsoft _snprintf_s(...,count,...) form) and were verified against real 32-bit ARM callsites.",
    "memcpy_s":     {"propagates": [{"from": "*arg:2", "to": "*arg:0"}],
                     "sink": {"tainted_args": [3], "class": "fortified_overflow", "detail": "attacker-controlled count to memcpy_s (bounds-checked; aborts at runtime)"}},
    "memmove_s":    {"propagates": [{"from": "*arg:2", "to": "*arg:0"}],
                     "sink": {"tainted_args": [3], "class": "fortified_overflow", "detail": "attacker-controlled count to memmove_s (bounds-checked; aborts at runtime)"}},
    "memset_s":     {"sink": {"tainted_args": [3], "class": "fortified_overflow", "detail": "attacker-controlled count to memset_s (bounds-checked; aborts at runtime)"}},
    "strcpy_s":     {"propagates": [{"from": "*arg:2", "to": "*arg:0"}],
                     "sink": {"tainted_args": [2], "class": "fortified_overflow", "detail": "tainted source into strcpy_s dest (bounds-checked; aborts at runtime)"}},
    "strncpy_s":    {"propagates": [{"from": "*arg:2", "to": "*arg:0"}],
                     "sink": {"tainted_args": [3], "class": "fortified_overflow", "detail": "attacker-controlled count to strncpy_s (bounds-checked; aborts at runtime)"}},
    "strcat_s":     {"propagates": [{"from": "*arg:2", "to": "*arg:0"}],
                     "sink": {"tainted_args": [2], "class": "fortified_overflow", "detail": "tainted source into strcat_s dest (bounds-checked; aborts at runtime)"}},
    "strncat_s":    {"propagates": [{"from": "*arg:2", "to": "*arg:0"}],
                     "sink": {"tainted_args": [3], "class": "fortified_overflow", "detail": "attacker-controlled count to strncat_s (bounds-checked; aborts at runtime)"}},
    "sprintf_s":    {"propagates": [{"from": "*arg:2", "to": "*arg:0"}],
                     "varargs": {"first_index": 3, "to": "*arg:0", "sink": true},
                     "sink": {"tainted_args": [2], "class": "fortified_format", "detail": "tainted format/args into sprintf_s (bounds-checked; aborts at runtime)"}},
    "snprintf_s":   {"propagates": [{"from": "*arg:2", "to": "*arg:0"}],
                     "varargs": {"first_index": 3, "to": "*arg:0"},
                     "sink": {"tainted_args": [2], "class": "fortified_format", "detail": "tainted format/args into snprintf_s (bounds-checked; aborts at runtime)"}},
    "vsnprintf_s":  {"propagates": [{"from": "*arg:2", "to": "*arg:0"}],
                     "sink": {"tainted_args": [2], "class": "fortified_format", "detail": "tainted format into vsnprintf_s (bounds-checked; aborts at runtime)"}},

    "_comment_optional_sinks": "Opt-in sinks: a sink with 'optional': true fires only when its 'class' is passed via --sink-class (engine: enabled_sink_classes). Off by default so 'tainted data written out' does not spam normal runs; useful when auditing persistence / file corruption / exfiltration. They are still non-empty models, so they suppress the conservative 'unmodeled external' fallback exactly like the benign {} entries they replace.",
    "fwrite":   {"sink": {"tainted_args": [0, 1, 2], "class": "file_write", "optional": true, "detail": "tainted data (arg0) or size/count (args1-2) written via fwrite"}},
    "fputs":    {"sink": {"tainted_args": [0], "class": "file_write", "optional": true, "detail": "tainted string written via fputs"}},
    "write":    {"sink": {"tainted_args": [1, 2], "class": "file_write", "optional": true, "detail": "tainted data (arg1) or length (arg2) written via write()"}},
    "send":     {"sink": {"tainted_args": [1, 2], "class": "net_write", "optional": true, "detail": "tainted data (arg1) or length (arg2) sent via send()"}},
    "sendto":   {"sink": {"tainted_args": [1, 2], "class": "net_write", "optional": true, "detail": "tainted data (arg1) or length (arg2) sent via sendto()"}},

    "_comment_glib": "GLib (glib-2.0) allocator / dup / list helpers, common on parser paths. Without models these surface as unmodeled_callee frontier leaves and flood output (#160). Allocators mirror malloc/calloc/realloc (alloc_size sink on the byte-count arg); g_free/g_slice_free are benign. The g_str*/g_memdup helpers return a freshly-allocated copy (propagate source -> *ret); g_strlcpy/g_strlcat are size-bounded copies (propagate, no overflow sink). List helpers store the data pointer into the container (propagate the data arg -> ret).",
    "g_malloc":        {"sink": {"tainted_args": [0], "class": "alloc_size", "detail": "attacker-controlled allocation size to g_malloc"}},
    "g_malloc0":       {"sink": {"tainted_args": [0], "class": "alloc_size", "detail": "attacker-controlled allocation size to g_malloc0"}},
    "g_try_malloc":    {"sink": {"tainted_args": [0], "class": "alloc_size", "detail": "attacker-controlled allocation size to g_try_malloc"}},
    "g_try_malloc0":   {"sink": {"tainted_args": [0], "class": "alloc_size", "detail": "attacker-controlled allocation size to g_try_malloc0"}},
    "g_malloc_n":      {"sink": {"tainted_args": [0, 1], "class": "alloc_size", "detail": "attacker-controlled allocation size to g_malloc_n"}},
    "g_malloc0_n":     {"sink": {"tainted_args": [0, 1], "class": "alloc_size", "detail": "attacker-controlled allocation size to g_malloc0_n"}},
    "g_realloc":       {"sink": {"tainted_args": [1], "class": "alloc_size", "detail": "attacker-controlled allocation size to g_realloc"}},
    "g_realloc_n":     {"sink": {"tainted_args": [1, 2], "class": "alloc_size", "detail": "attacker-controlled allocation size to g_realloc_n"}},
    "g_slice_alloc":   {"sink": {"tainted_args": [0], "class": "alloc_size", "detail": "attacker-controlled allocation size to g_slice_alloc"}},
    "g_slice_alloc0":  {"sink": {"tainted_args": [0], "class": "alloc_size", "detail": "attacker-controlled allocation size to g_slice_alloc0"}},
    "g_free":          {},
    "g_slice_free1":   {},
    "g_strdup":        {"propagates": [{"from": "*arg:0", "to": "*ret"}]},
    "g_strndup":       {"propagates": [{"from": "*arg:0", "to": "*ret"}]},
    "g_strdup_printf": {"propagates": [{"from": "*arg:0", "to": "*ret"}], "varargs": {"first_index": 1, "to": "*ret"}},
    "g_strconcat":     {"propagates": [{"from": "*arg:0", "to": "*ret"}], "varargs": {"first_index": 1, "to": "*ret"}},
    "g_memdup":        {"propagates": [{"from": "*arg:0", "to": "*ret"}]},
    "g_memdup2":       {"propagates": [{"from": "*arg:0", "to": "*ret"}]},
    "g_strlcpy":       {"propagates": [{"from": "*arg:1", "to": "*arg:0"}]},
    "g_strlcat":       {"propagates": [{"from": "*arg:1", "to": "*arg:0"}]},
    "g_ascii_strtoull":{"propagates": [{"from": "*arg:0", "to": "ret"}]},
    "g_ascii_strtoll": {"propagates": [{"from": "*arg:0", "to": "ret"}]},
    "g_slist_append":  {"propagates": [{"from": "arg:1", "to": "ret"}]},
    "g_slist_prepend": {"propagates": [{"from": "arg:1", "to": "ret"}]},
    "g_list_append":   {"propagates": [{"from": "arg:1", "to": "ret"}]},
    "g_list_prepend":  {"propagates": [{"from": "arg:1", "to": "ret"}]},

    "_comment_benign": "Empty models mark functions that neither source, propagate, nor sink taint, so a tainted argument does not trigger the conservative 'unmodeled external' fallback. They cut noise without hiding real flows.",
    "socket": {}, "bind": {}, "listen": {}, "accept": {}, "connect": {},
    "setsockopt": {}, "getsockopt": {}, "getsockname": {}, "getpeername": {},
    "close": {}, "shutdown": {},
    "htons": {}, "htonl": {}, "ntohs": {}, "ntohl": {}, "inet_addr": {},
    "exit": {}, "abort": {}, "perror": {}, "fflush": {}, "fclose": {}, "puts": {},
    "strcmp": {}, "strncmp": {}, "strcasecmp": {}, "strncasecmp": {},
    "bzero": {}, "__builtin_memset": {}, "srand": {}, "rand": {}, "time": {}
  }
}
