{
  "description": "strncat's count is not destination-relative geometry; strncpy's is.",
  "lang": "c",
  "cflags": [
    "-fno-inline",
    "-fno-builtin",
    "-fno-strict-aliasing",
    "-U_FORTIFY_SOURCE"
  ],
  "backward": [
    {
      "function": "append_length",
      "sink": "arg:memcpy:2",
      "origin_kinds": [
        "field_load_unresolved",
        "source",
        "parameter"
      ],
      "forbid_origin_kinds": [
        "constant"
      ],
      "leaves": [
        {
          "kind": "field_load_unresolved"
        }
      ],
      "complete_slice": false
    },
    {
      "function": "copy_length",
      "sink": "arg:memcpy:2",
      "origin_kinds": [
        "constant"
      ],
      "forbid_leaves": [
        {
          "kind": "field_load_unresolved"
        }
      ],
      "complete_slice": true
    }
  ]
}
